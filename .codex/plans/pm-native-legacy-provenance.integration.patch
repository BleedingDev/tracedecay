diff --git a/crates/tracedecay/src/daemon/retained_owner/native_provider_tests.rs b/crates/tracedecay/src/daemon/retained_owner/native_provider_tests.rs
--- a/crates/tracedecay/src/daemon/retained_owner/native_provider_tests.rs
