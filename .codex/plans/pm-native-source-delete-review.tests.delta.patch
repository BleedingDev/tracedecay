+            assert_eq!(
+                visible["candidates"][0]["content"],
+                source_b["canonical_payload"]["content"]
+            );
+            assert_eq!(
+                visible["candidates"][0]["provenance"]["original_sources"][0],
+                source_b["source_identity"]["original_source"]
