+            assert!(
+                !database
+                    .register_live_session_locator(
+                        "claude",
+                        "live-session",
+                        project_path,
+                        transcript_path,
+                    )
+                    .await
+                    .unwrap()
+            );
+            assert_eq!(
+                database
+                    .get_session_result("claude", "live-session")
+                    .await
+                    .unwrap(),
+                Some(expected.clone())
+            );
+        }
+    }
+
