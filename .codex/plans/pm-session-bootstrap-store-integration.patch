+        let (_directory, database, _owner) = project_locator_store().await;
+        let mut expected = observed_session(None);
+        assert!(database.upsert_session(&expected).await);
+        assert!(
+            !database
+                .register_live_session_locator(
+                    "claude",
+                    "live-session",
+                    "c:/other-project",
+                    "/native/live-session.jsonl",
