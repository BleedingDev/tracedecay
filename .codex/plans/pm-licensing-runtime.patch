@@ -0,0 +1,108 @@
+#![allow(clippy::expect_used, clippy::panic, clippy::unwrap_used)]
+#![doc = "License admission at the real worker startup and request boundaries."]
+
+use serde_json::{Value, json};
+use std::io::Cursor;
+use std::process::{Command, Stdio};
+use std::sync::Arc;
+use tempfile::TempDir;
+use tracedecay_memory_ncm_core::types::{NcmConfig, SourceId};
+use tracedecay_memory_ncm_runtime::embedding::doubles::HashEncoder;
+use tracedecay_memory_ncm_runtime::engine::{NcmEngine, ObserveRequest, Outcome};
+use tracedecay_memory_ncm_runtime::ports::{Deadline, StateRoot};
+use tracedecay_memory_ncm_runtime::wire::{self, Operation, Request};
+
+#[test]
+fn worker_startup_requires_license_before_state_or_encoder_work() {
+    let directory = TempDir::new().unwrap();
+    let profile = directory.path().join("absent-profile");
+    let state = directory.path().join("absent-state");
+    let output = Command::new(env!("CARGO_BIN_EXE_tracedecay-ncm-worker"))
+        .args(["--state-root", state.to_str().unwrap(), "--test-double"])
+        .env("TRACEDECAY_DATA_DIR", &profile)
+        .stdin(Stdio::null())
+        .output()
+        .unwrap();
+    if tracedecay_licensing::LICENSED_DISTRIBUTION {
+        assert_eq!(output.status.code(), Some(2));
+        assert_eq!(output.stderr, b"TraceDecay license admission denied.\n");
+    } else {
+        assert!(output.status.success(), "{output:?}");
+        assert!(output.stderr.is_empty());
+    }
+    assert!(output.stdout.is_empty());
+    assert!(!state.exists());
+    assert!(!profile.exists());
+}
+
+#[test]
+fn worker_request_checks_license_before_observation_side_effects() {
+    let directory = TempDir::new().unwrap();
+    let state = directory.path().join("request-state");
+    let mut config = NcmConfig {
+        terrain_resolution: 3,
+        ..NcmConfig::default()
+    };
+    config.stm.n_centers = 8;
+    config.stm.top_k_read = 8;
+    config.stm.top_k_write = 8;
+    config.ltm.n_centers = 8;
+    config.ltm.top_k_read = 8;
+    config.ltm.top_k_write = 8;
+    config.hybrid_candidates = 8;
+    let engine = Arc::new(NcmEngine::new(
+        StateRoot::new(&state).unwrap(),
+        Arc::new(HashEncoder::new()),
+        config,
+    ));
+    let observation = ObserveRequest {
+        idempotency_key: "license-bound-observation".to_owned(),
+        payload_sha256: String::new(),
+        source: SourceId("license-test-source".to_owned()),
+        key_text: "license test".to_owned(),
+        value_text: "This observation must require an admitted process.".to_owned(),
+        affect: None,
+        surprise: 0.2,
+        intensity: 1.0,
+        provenance: json!({"origin":"license-boundary-test"}),
+        deadline: Deadline {
+            remaining_ms: 10000,
+        },
+    };
+    let request = Request::new(
+        7,
+        10000,
+        Operation::Observe,
+        "ab".repeat(32),
+        json!({
+            "idempotency_key":observation.idempotency_key,
+            "payload_sha256":observation.canonical_payload_sha256().unwrap(),
+            "source":observation.source.0,
+            "key_text":observation.key_text,
+            "value_text":observation.value_text,
+            "affect":observation.affect,
+            "surprise":observation.surprise,
+            "intensity":observation.intensity,
+            "provenance":observation.provenance
+        }),
+    );
+    let input = wire::encode_request(&request).unwrap();
+    let mut output = Vec::new();
+    tracedecay_memory_ncm_runtime::worker::serve(Cursor::new(input), &mut output, engine).unwrap();
+    let reply = wire::read_reply(&mut Cursor::new(output)).unwrap().unwrap();
+    assert_eq!(reply.id, request.id);
+    if tracedecay_licensing::LICENSED_DISTRIBUTION {
+        assert_eq!(
+            reply.outcome,
+            Outcome::Unavailable("license admission denied".to_owned())
+        );
+        assert_eq!(reply.state_generation, 0);
+        assert_eq!(reply.payload, None);
+        assert!(!state.exists());
+    } else {
+        assert_eq!(reply.outcome, Outcome::Success, "{reply:?}");
+        assert_eq!(reply.state_generation, 1);
+        assert_ne!(reply.payload, Some(Value::Null));
+        assert!(state.exists());
+    }
+}
