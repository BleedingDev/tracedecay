+#[cfg(test)]
+mod license_admission_tests {
+    use super::*;
+
+    #[tokio::test]
+    async fn http_license_is_checked_before_the_mounted_application_handler() {
+        let reached = Arc::new(AtomicUsize::new(0));
+        let handler_reached = Arc::clone(&reached);
+        let registry = DaemonHttpApplicationRegistry::default();
+        registry
+            .mount(
+                "license-project",
+                Router::new().route(
+                    "/probe",
+                    get(move || {
+                        handler_reached.fetch_add(1, Ordering::SeqCst);
+                        async { StatusCode::NO_CONTENT }
+                    }),
+                ),
+            )
+            .await
+            .unwrap();
+        let admission = LocalHttpAdmission::new(
+            &"ab".repeat(32),
+            SocketAddr::from((Ipv4Addr::LOCALHOST, 12345)),
+        )
+        .unwrap();
+        let request = Request::builder()
+            .uri("/projects/license-project/application/probe")
+            .header(AUTHORIZATION, admission.authorization.clone())
+            .header(ORIGIN, admission.origin.clone())
+            .body(Body::empty())
+            .unwrap();
+        let (router, _) = registry.router(admission).unwrap();
+        let response = router.oneshot(request).await.unwrap();
+        if tracedecay_licensing::LICENSED_DISTRIBUTION {
+            assert_eq!(response.status(), StatusCode::FORBIDDEN);
+            assert_eq!(reached.load(Ordering::SeqCst), 0);
+        } else {
+            assert_eq!(response.status(), StatusCode::NO_CONTENT);
+            assert_eq!(reached.load(Ordering::SeqCst), 1);
+        }
+    }
+}
