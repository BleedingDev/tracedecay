+fn acquire_directory_creation_lock(
+    lock_path: &Path,
+    interrupt: &mut Option<&mut dyn FnMut() -> io::Result<()>>,
+) -> io::Result<fs::File> {
+    let Some(interrupt) = interrupt.as_deref_mut() else {
+        return acquire_lock_file_blocking(lock_path, true);
