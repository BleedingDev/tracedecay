+    #[test]
+    fn each_restart_requires_its_own_independent_audit_and_coverage_stays_explicit() {
+        let mut values = BTreeMap::from([("install".into(), json!({"records":[caller_only()]}))]);
+        assert!(prerequisite(&values, "install", "audit_one").is_some());
+        values.insert(
