+            let trace = reopened
+                .explain_trace(trace_wire.rsplit(':').next().unwrap())
+                .unwrap()
+                .unwrap()
+                .trace;
+            assert_eq!(trace.items[2].stage, RecallExplainStageV1::Injected);
+            assert!(
+                trace.items[..2]
