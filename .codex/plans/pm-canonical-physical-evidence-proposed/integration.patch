+/// Physical fixture evidence uses the existing identity/ledger matcher without
+/// fabricating a registered shard or constructing a provider authority owner.
+#[cfg(feature = "test-helpers")]
+#[allow(clippy::too_many_arguments)]
+pub(crate) fn observe_canonical_session_origin_for_test(
+    data_root: &Path,
+    project_root: &Path,
+    profile: &tracedecay_daemon_identity::profile_identity::LocalProfileIdentityAuthorityV1,
+    mounted_scope: &ResolvedScope,
+    canonical_provider_id: &str,
+    session_id: &str,
+    project_path: &str,
+    expected_destination: &OwnedExactScope,
+    control: &tracedecay_memory_provider_registry::OperationControl,
+) -> HistoryResult<(
+    OwnedExactScope,
+    Vec<tracedecay_hooks::admission_ledger::HookLiveOriginBoundaryV1>,
+)> {
+    control
+        .snapshot()
+        .map_err(ProviderHistoryErrorV1::Control)?;
+    let bridge = HistoryIdentityBridgeV1::from_project_scope(
+        project_root,
+        profile.profile_id(),
+        mounted_scope,
+    );
+    control
+        .snapshot()
+        .map_err(ProviderHistoryErrorV1::Control)?;
+    let bridge = bridge?;
+    let reader = HookOriginReaderV1::new(
+        data_root.to_path_buf(),
+        profile.brain_id().clone(),
+        profile.profile_id().clone(),
+    );
+    let boundaries = bridge.live_canonical_session_boundaries(
+        &reader,
+        canonical_provider_id,
+        session_id,
+        project_path,
+        expected_destination,
+        control,
+    )?;
+    let destination = bridge.destination(session_id)?;
+    control
+        .snapshot()
+        .map_err(ProviderHistoryErrorV1::Control)?;
+    Ok((destination, boundaries))
