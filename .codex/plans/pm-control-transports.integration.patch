+    #[test]
+    fn provider_routes_decode_only_the_selected_public_inner_request() {
+        let source = json!({"trace_ref":"trace.retained","item_ref":"item.1","observation_id":"observation.1"});
+        let state = json!({"kind":"canonical_session","provider_id":"native","registration_revision":7,"canonical_provider_id":"claude","session_id":"session.original"});
+        for (operation, variant, body) in [
+            (
+                RetainedSurfaceOperation::ProviderFeedback,
+                "feedback",
+                json!({"source":source,"signal":"helpful","weight":"0.5","evidence_refs":[],"occurred_at":10}),
+            ),
+            (
+                RetainedSurfaceOperation::ProviderCorrection,
+                "correction",
+                json!({"source":source,"expected_source_revision":"revision.1","correction":{"kind":"replace_content","replacement_source":source},"reason":"Correction evidence","evidence_refs":[]}),
+            ),
+            (
+                RetainedSurfaceOperation::ProviderDeleteBySource,
+                "delete_by_source",
+                json!({"source":source,"mode":"remove_influence","expected_fence_revision":0,"include_snapshots":true}),
+            ),
+            (
+                RetainedSurfaceOperation::ProviderHealth,
+                "health",
+                json!({"state":state,"requested_checks":["state"]}),
+            ),
+            (
+                RetainedSurfaceOperation::ProviderInspection,
+                "inspection",
+                json!({"state":state,"selection":{"view":"source_influence","source":source},"maximum_items":10,"maximum_bytes":65536}),
+            ),
+            (
+                RetainedSurfaceOperation::ProviderMaintenance,
+                "maintenance",
+                json!({"state":state,"task":"validate_state","maximum_items":20,"maximum_bytes":65536,"maximum_duration_millis":1000,"dry_run":false}),
+            ),
+            (
+                RetainedSurfaceOperation::ProviderSnapshotExport,
+                "snapshot_export",
+                json!({"state":state,"maximum_bytes":65536}),
+            ),
+            (
+                RetainedSurfaceOperation::ProviderSnapshotRestore,
+                "snapshot_restore",
+                json!({"state":state,"snapshot_ref":"snapshot.host.1","expected_state_generation":3}),
+            ),
+            (
+                RetainedSurfaceOperation::ProviderReplay,
+                "replay",
+                json!({"state":state,"observation_batch_refs":["observation.batch.1"],"first_source_sequence":1,"last_source_sequence":1,"expected_state_generation":3,"expected_previous_acknowledged_sequence":0}),
+            ),
+        ] {
+            let decoded = decode_request(operation, body.clone()).expect("selected typed request");
+            assert_eq!(decoded.operation(), operation);
+            let RetainedSurfaceRequestV1::ProviderControl(inner) = decoded else {
+                panic!("provider control wrapper required");
+            };
+            inner
+                .validate_at(tracedecay_domain::UtcMicros(10))
+                .expect("valid control request");
+            let wrapped = json!({"operation":variant,"request":body});
+            assert_eq!(serde_json::to_value(inner).expect("typed wrapper"), wrapped);
+            assert!(
+                decode_request(operation, wrapped).is_err(),
+                "caller may not choose a wrapped operation"
+            );
+            let mut with_authority = body;
+            with_authority["provider_instance_id"] = json!("caller.instance");
+            assert!(
+                decode_request(operation, with_authority).is_err(),
+                "host authority is not a public field"
+            );
+        }
+        assert!(
+            decode_request(
+                RetainedSurfaceOperation::ProviderHealth,
+                json!({"state":state,"maximum_bytes":65536}),
+            )
+            .is_err(),
+            "an export body cannot select health"
+        );
+    }
