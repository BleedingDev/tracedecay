+    let nonexistent = format!("ncm-memory:{}", "00".repeat(32));
+    let missing = receipt_inspection(
+        &live,
+        observed.state_generation,
+        "ordinary-key",
+        Some(&nonexistent),
+        0,
+        16,
+    );
+    assert!(missing["items"].as_array().unwrap().is_empty());
+    assert_eq!(missing["partial"], true);
+}
