+fn replay_item_digest(item: &ReplayItem) -> Result<String, String> {
+    canonical_digest(
+        &json!({"sequence":item.sequence,"receipt":item.receipt_digest,"source":item.source,"admitted":item.admitted,"observation":item.observation["payload_sha256"]}),
+    )
