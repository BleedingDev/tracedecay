{
  "schema_version": 1,
  "bead_id": "tdmem-0103",
  "title": "TraceDecay V2 Native memory production surface map",
  "scope": "Coding-agent memory paths on feat/pluggable-memory-providers-v2; provider behavior is unchanged.",
  "invariants": [
    "FactOwnerV1 is the immutable scope key for every Native fact read and write.",
    "Explicit facts have one canonical writer: the owner-bound Native fact authority.",
    "Provider recall candidates are advisory and cannot mutate canonical facts or code truth.",
    "Session observations and LCM history are separate authorities; automation may promote reviewed material only through the Native fact write path.",
    "Search indexes, FHRR vectors, trust summaries, dashboards, and the Grafeo relation graph are derived and rebuildable.",
    "Every production effect propagates request identity, deadline/cancellation, typed terminal outcomes, and durable reconciliation where required."
  ],
  "authorities": [
    {
      "id": "native_explicit_fact_log",
      "class": "canonical",
      "state": "append_only_facts_lineage_and_provenance",
