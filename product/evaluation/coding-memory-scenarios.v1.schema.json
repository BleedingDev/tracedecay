{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tracedecay.dev/schemas/coding-memory-scenarios.v1.schema.json",
  "title": "TraceDecay deterministic coding-memory scenario corpus V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "corpus_id",
    "bead_id",
    "canonical_encoding",
    "provider_neutral",
    "provider_selection",
    "fixture_policy",
    "adjudication_policy",
    "scope_catalog",
    "fixtures",
    "recall_requests",
    "scenarios"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "corpus_id": {"const": "tracedecay.coding-memory.scenarios.v1"},
    "bead_id": {"const": "tdmem-0901"},
    "title": {"type": "string", "minLength": 1},
    "canonical_encoding": {"const": "utf8_rfc8785_json_without_bom_with_lf"},
    "provider_neutral": {"const": true},
    "provider_selection": {"$ref": "#/$defs/providerSelection"},
    "fixture_policy": {"$ref": "#/$defs/fixturePolicy"},
    "adjudication_policy": {"$ref": "#/$defs/adjudicationPolicy"},
    "scope_catalog": {
      "type": "array",
      "minItems": 4,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/scope"}
    },
    "fixtures": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/fixture"}
    },
    "recall_requests": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/recallRequest"}
    },
    "scenarios": {
      "type": "array",
      "minItems": 9,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/scenario"}
    }
  },
  "$defs": {
    "providerSelection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "same_fixture_and_task_for_each_provider",
        "provider_identity_is_run_metadata",
        "provider_output_is_advisory",
        "observer_output_participates_in_adjudication"
      ],
      "properties": {
        "mode": {"const": "runner_supplied"},
        "same_fixture_and_task_for_each_provider": {"const": true},
        "provider_identity_is_run_metadata": {"const": true},
        "provider_output_is_advisory": {"const": true},
        "observer_output_participates_in_adjudication": {"const": false}
      }
    },
    "fixturePolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["clock", "randomness", "network", "filesystem", "external_processes", "credentials", "source_material"],
      "properties": {
        "clock": {"const": "fixed_utc_timestamps"},
        "randomness": {"const": "none"},
        "network": {"const": "forbidden"},
        "filesystem": {"const": "temporary_fixture_only"},
        "external_processes": {"const": "forbidden"},
        "credentials": {"const": "none"},
        "source_material": {"const": "synthetic_and_versioned"}
      }
    },
    "adjudicationPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["score_range", "safety_gate", "indeterminate_policy", "provider_failure_policy", "missing_evidence_policy", "context_owner"],
      "properties": {
        "score_range": {"const": [0, 1]},
        "safety_gate": {"type": "string", "minLength": 1},
        "indeterminate_policy": {"type": "string", "minLength": 1},
        "provider_failure_policy": {"type": "string", "minLength": 1},
        "missing_evidence_policy": {"const": "indeterminate"},
        "context_owner": {"const": "trace_decay_context_compiler"}
      }
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scope_id", "profile_id", "project_id", "repository_id", "worktree_id", "branch_ref", "agent_session_id", "scope_revision"],
      "properties": {
        "scope_id": {"type": "string", "pattern": "^[a-z][a-z0-9_]+$"},
        "profile_id": {"type": "string", "minLength": 1},
        "project_id": {"type": "string", "minLength": 1},
        "repository_id": {"type": "string", "minLength": 1},
        "worktree_id": {"type": "string", "minLength": 1},
        "branch_ref": {"type": "string", "minLength": 1},
        "agent_session_id": {"type": "string", "minLength": 1},
        "scope_revision": {"type": "integer", "minimum": 1}
      }
    },
    "fixture": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fixture_id", "repository_identity", "fixture_digest", "root_kind", "files"],
      "properties": {
        "fixture_id": {"type": "string", "pattern": "^[a-z][a-z0-9_]+$"},
        "repository_identity": {"type": "string", "minLength": 1},
        "fixture_digest": {"$ref": "#/$defs/digest"},
        "root_kind": {"const": "temporary_git_repository"},
        "files": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/file"}}
      }
    },
    "file": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "revisions"],
      "properties": {
        "path": {"type": "string", "pattern": "^(src|tests|docs|notes)/[^/]+\\.[a-z0-9]+$"},
        "revisions": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/fileRevision"}}
      }
    },
    "fileRevision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["revision_id", "revision", "content", "content_sha256"],
      "properties": {
        "revision_id": {"type": "string", "pattern": "^[a-z][a-z0-9_]+$"},
        "revision": {"type": "integer", "minimum": 1},
        "content": {"type": "string", "minLength": 1},
        "content_sha256": {"$ref": "#/$defs/digest"}
      }
    },
    "scenario": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "category",
        "title",
        "fixture_id",
        "task",
        "source_scope_id",
        "target_scope_id",
        "steps",
        "observations",
        "code_evidence_revisions",
        "expected_admissible_behavior",
        "adjudication_rubric"
      ],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z][a-z0-9_]+$"},
        "category": {"type": "string", "minLength": 1},
        "title": {"type": "string", "minLength": 1},
        "fixture_id": {"type": "string", "minLength": 1},
        "task": {"type": "string", "minLength": 1},
        "source_scope_id": {"type": "string", "minLength": 1},
        "target_scope_id": {"type": "string", "minLength": 1},
        "steps": {"type": "array", "minItems": 2, "items": {"$ref": "#/$defs/step"}},
        "observations": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/observation"}},
        "code_evidence_revisions": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/evidenceRevision"}},
        "expected_admissible_behavior": {"$ref": "#/$defs/behavior"},
        "adjudication_rubric": {"$ref": "#/$defs/rubric"}
      }
    },
    "step": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["step", "action", "observation_id"],
          "properties": {
            "step": {"type": "integer", "minimum": 1},
            "action": {"const": "observe"},
            "observation_id": {"type": "string", "pattern": "^[a-z][a-z0-9_]+$"}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["step", "action", "observation_id", "operation_id"],
          "properties": {
            "step": {"type": "integer", "minimum": 1},
            "action": {"const": "observe"},
            "observation_id": {"type": "string", "pattern": "^[a-z][a-z0-9_]+$"},
            "operation_id": {"type": "string", "pattern": "^[a-z][a-z0-9_]+$"}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["step", "action", "revision_id"],
          "properties": {
            "step": {"type": "integer", "minimum": 1},
            "action": {"const": "advance_code"},
            "revision_id": {"type": "string", "pattern": "^[a-z][a-z0-9_]+$"}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["step", "action", "request_id"],
          "properties": {
            "step": {"type": "integer", "minimum": 1},
            "action": {"const": "recall"},
            "request_id": {"type": "string", "pattern": "^[a-z][a-z0-9_]+$"}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["step", "action", "request_id", "scope_id"],
          "properties": {
            "step": {"type": "integer", "minimum": 1},
            "action": {"const": "recall"},
            "request_id": {"type": "string", "pattern": "^[a-z][a-z0-9_]+$"},
            "scope_id": {"type": "string", "pattern": "^[a-z][a-z0-9_]+$"}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["step", "action", "rubric"],
          "properties": {
            "step": {"type": "integer", "minimum": 1},
            "action": {"const": "adjudicate"},
            "rubric": {"type": "string", "pattern": "^[a-z][a-z0-9_]+$"}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["step", "action", "scope_id"],
          "properties": {
            "step": {"type": "integer", "minimum": 1},
            "action": {"const": "open_new_agent_session"},
            "scope_id": {"type": "string", "pattern": "^[a-z][a-z0-9_]+$"}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["step", "action", "restart_id"],
          "properties": {
            "step": {"type": "integer", "minimum": 1},
            "action": {"const": "restart_provider"},
            "restart_id": {"type": "string", "pattern": "^[a-z][a-z0-9_]+$"}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["step", "action", "observation_id", "operation_id"],
          "properties": {
            "step": {"type": "integer", "minimum": 1},
            "action": {"const": "replay"},
            "observation_id": {"type": "string", "pattern": "^[a-z][a-z0-9_]+$"},
            "operation_id": {"type": "string", "pattern": "^[a-z][a-z0-9_]+$"}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["step", "action", "batch_id"],
          "properties": {
            "step": {"type": "integer", "minimum": 1},
            "action": {"const": "begin_observation_batch"},
            "batch_id": {"type": "string", "pattern": "^[a-z][a-z0-9_]+$"}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["step", "action", "item_id"],
          "properties": {
            "step": {"type": "integer", "minimum": 1},
            "action": {"const": "commit_item"},
            "item_id": {"type": "string", "pattern": "^[a-z][a-z0-9_]+$"}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["step", "action", "cancel_id", "at_item"],
          "properties": {
            "step": {"type": "integer", "minimum": 1},
            "action": {"const": "cancel"},
            "cancel_id": {"type": "string", "pattern": "^[a-z][a-z0-9_]+$"},
            "at_item": {"type": "integer", "minimum": 1}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["step", "action", "resume_cursor"],
          "properties": {
            "step": {"type": "integer", "minimum": 1},
            "action": {"const": "resume"},
            "resume_cursor": {"type": "string", "pattern": "^[a-z][a-z0-9_]+$"}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["step", "action", "state_id", "digest_status"],
          "properties": {
            "step": {"type": "integer", "minimum": 1},
            "action": {"const": "load_provider_state"},
            "state_id": {"type": "string", "pattern": "^[a-z][a-z0-9_]+$"},
            "digest_status": {"enum": ["match", "mismatch"]}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["step", "action", "request_id"],
          "properties": {
            "step": {"type": "integer", "minimum": 1},
            "action": {"const": "health"},
            "request_id": {"type": "string", "pattern": "^[a-z][a-z0-9_]+$"}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["step", "action", "forget_source_key"],
          "properties": {
            "step": {"type": "integer", "minimum": 1},
            "action": {"const": "delete_by_source"},
            "forget_source_key": {"type": "string", "pattern": "^[a-z][a-z0-9_]+$"}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["step", "action", "request_id"],
          "properties": {
            "step": {"type": "integer", "minimum": 1},
            "action": {"const": "verify_absence"},
            "request_id": {"type": "string", "pattern": "^[a-z][a-z0-9_]+$"}
          }
        }
      ]
    },
    "recallRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["request_id", "scenario_id", "operation", "scope_id", "temporal_query", "policy_revision"],
      "properties": {
        "request_id": {"type": "string", "pattern": "^request_[a-z0-9_]+$"},
        "scenario_id": {"type": "string", "pattern": "^[a-z][a-z0-9_]+$"},
        "operation": {"enum": ["recall", "verify_absence", "health"]},
        "scope_id": {"type": "string", "pattern": "^[a-z][a-z0-9_]+$"},
        "objective": {"enum": ["search", "probe", "related", "reason"]},
        "query": {"type": "string", "minLength": 1, "maxLength": 32768, "pattern": "^\\S(?:.*\\S)?$"},
        "temporal_query": {
          "type": "object",
          "additionalProperties": false,
          "required": ["mode", "evaluation_time"],
          "properties": {
            "mode": {"const": "current"},
            "evaluation_time": {"type": "string", "format": "date-time"}
          }
        },
        "budgets": {
          "type": "object",
          "additionalProperties": false,
          "required": ["maximum_candidates", "maximum_candidate_content_bytes", "maximum_total_content_bytes", "maximum_source_refs_per_candidate", "maximum_trace_refs_per_candidate", "maximum_warnings", "maximum_extensions_per_candidate"],
          "properties": {
            "maximum_candidates": {"type": "integer", "minimum": 1},
            "maximum_candidate_content_bytes": {"type": "integer", "minimum": 1},
            "maximum_total_content_bytes": {"type": "integer", "minimum": 1},
            "maximum_source_refs_per_candidate": {"type": "integer", "minimum": 1},
            "maximum_trace_refs_per_candidate": {"type": "integer", "minimum": 1},
            "maximum_warnings": {"type": "integer", "minimum": 1},
            "maximum_extensions_per_candidate": {"type": "integer", "minimum": 1}
          }
        },
        "exclusions": {
          "type": "object",
          "additionalProperties": false,
          "required": ["stable_memory_refs", "candidate_ids", "source_refs", "trace_refs", "observation_ids", "content_sha256"],
          "properties": {
            "stable_memory_refs": {"type": "array", "items": {"type": "string"}},
            "candidate_ids": {"type": "array", "items": {"type": "string"}},
            "source_refs": {"type": "array", "items": {"type": "string"}},
            "trace_refs": {"type": "array", "items": {"type": "string"}},
            "observation_ids": {"type": "array", "items": {"type": "string"}},
            "content_sha256": {"type": "array", "items": {"type": "string"}}
          }
        },
        "policy_revision": {"type": "integer", "minimum": 1}
      },
      "if": {"properties": {"operation": {"enum": ["recall", "verify_absence"]}}},
      "then": {"required": ["objective", "query", "budgets", "exclusions"]},
      "else": {"not": {"anyOf": [{"required": ["objective"]}, {"required": ["query"]}, {"required": ["budgets"]}, {"required": ["exclusions"]}]}}
    },
    "observation": {
      "type": "object",
      "required": ["observation_id", "source_sequence", "event_type", "occurred_at", "scope_id", "source_revision", "source_digest", "settlement", "payload"],
      "properties": {
        "observation_id": {"type": "string", "pattern": "^[a-z][a-z0-9_]+$"},
        "source_sequence": {"type": "integer", "minimum": 1},
        "event_type": {"type": "string", "minLength": 1},
        "occurred_at": {"type": "string", "format": "date-time"},
        "scope_id": {"type": "string", "minLength": 1},
        "source_revision": {"type": "string", "minLength": 1},
        "source_digest": {"$ref": "#/$defs/digest"},
        "settlement": {"const": "settled"},
        "payload": {"type": "object"}
      }
    },
    "evidenceRevision": {
      "type": "object",
      "required": ["revision_id", "revision", "parent_revision_id", "scope_id", "changed_files", "evidence"],
      "properties": {
        "revision_id": {"type": "string", "minLength": 1},
        "revision": {"type": "integer", "minimum": 1},
        "parent_revision_id": {"type": ["string", "null"]},
        "scope_id": {"type": "string", "minLength": 1},
        "changed_files": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "evidence": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/evidence"}}
      }
    },
    "evidence": {
      "type": "object",
      "required": ["evidence_id", "kind", "status", "assertion", "digest"],
      "properties": {
        "evidence_id": {"type": "string", "minLength": 1},
        "kind": {"type": "string", "minLength": 1},
        "status": {"type": "string", "enum": ["pass", "fail", "indeterminate"]},
        "assertion": {"type": "string", "minLength": 1},
        "digest": {"$ref": "#/$defs/digest"}
      }
    },
    "behavior": {
      "type": "object",
      "required": ["admission", "must", "must_not", "allowed_terminal_outcomes", "provider_effect"],
      "properties": {
        "admission": {"type": "string", "minLength": 1},
        "authority_order": {"type": "array", "items": {"type": "string"}},
        "must": {"type": "array", "minItems": 2, "items": {"type": "string", "minLength": 1}},
        "must_not": {"type": "array", "minItems": 2, "items": {"type": "string", "minLength": 1}},
        "allowed_terminal_outcomes": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "provider_effect": {"type": "string", "minLength": 1}
      }
    },
    "rubric": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rubric_id", "version", "mode", "pass_threshold", "checks"],
      "properties": {
        "rubric_id": {"type": "string", "minLength": 1},
        "version": {"const": 1},
        "mode": {"const": "weighted_all_safety_checks"},
        "pass_threshold": {"const": 1},
        "checks": {"type": "array", "minItems": 3, "items": {"$ref": "#/$defs/check"}}
      }
    },
    "check": {
      "type": "object",
      "additionalProperties": false,
      "required": ["check_id", "weight", "pass_if", "fail_if"],
      "properties": {
        "check_id": {"type": "string", "pattern": "^[a-z][a-z0-9_]+$"},
        "weight": {"type": "number", "exclusiveMinimum": 0, "maximum": 1},
        "pass_if": {"type": "string", "minLength": 1},
        "fail_if": {"type": "string", "minLength": 1}
      }
    },
    "digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
