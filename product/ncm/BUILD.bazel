load("//scripts:bazel/ncm_worker_bundle.bzl", "ncm_worker_bundle")

package(default_visibility = ["//visibility:public"])

exports_files([
    "reference/worker-manifest.json",
    "release/model-acquisition-manifest.json",
])

ncm_worker_bundle(
    name = "worker_bundle",
    worker = "//crates/tracedecay-memory-ncm-runtime:tracedecay-ncm-worker",
    reference_manifest = "reference/worker-manifest.json",
    model_manifest = "release/model-acquisition-manifest.json",
)

filegroup(
    name = "worker",
    srcs = [":worker_bundle"],
    output_group = "worker",
    data = [":worker_manifest", ":model_acquisition_manifest"],
)

filegroup(
    name = "worker_manifest",
    srcs = [":worker_bundle"],
    output_group = "worker_manifest",
)

filegroup(
    name = "model_acquisition_manifest",
    srcs = [":worker_bundle"],
    output_group = "model_acquisition_manifest",
)

