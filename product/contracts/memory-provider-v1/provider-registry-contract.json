{
  "schema_version": 1,
  "contract_id": "tracedecay.memory.provider.registry.v1",
  "bead_id": "tdmem-0201",
  "title": "Memory provider identity and capability registry contract",
  "status": "accepted",
  "authority": "TraceDecay provider registry composition root",
  "scope": "coding_agents_only",
  "provider_identity": {
    "type_name": "MemoryProviderIdV1",
    "encoding": "utf-8",
    "canonical_pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$",
    "minimum_bytes": 1,
    "maximum_bytes": 64,
    "case_sensitive": true,
    "stable_across_restarts": true,
    "stable_across_adapter_upgrades": true,
    "display_name_is_not_identity": true,
    "forbidden_sources": [
      "display_name",
      "process_id",
      "socket_path",
      "database_path",
      "provider_state_digest",
      "runtime_order",
      "configuration_position"
    ]
  },
  "capability_identity": {
    "type_name": "MemoryProviderCapabilityIdV1",
    "canonical_pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*\\.v[1-9][0-9]*$",
    "maximum_bytes": 96,
    "version_is_part_of_identity": true,
    "provider_name_is_not_capability_identity": true,
    "duplicate_capability_policy": "reject_non_canonical_declaration",
    "unknown_declaration_policy": "preserve_opaque_inert",
    "unknown_selection_policy": "typed_capability_unsupported"
  },
  "capability_registry": {
    "mandatory": [
      {
