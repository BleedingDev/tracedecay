            "name": "request",
            "contract_id": "tracedecay.memory.provider.health.request.v1",
            "required": true,
            "description": "Canonical provider-neutral request envelope admitted by TraceDecay."
          }
        ],
        "outputs": [
          {
            "name": "outcome",
            "contract_id": "tracedecay.memory.provider.health.outcome.v1",
            "required": true,
            "description": "Canonical typed outcome; success never hides degradation or terminal failure."
          }
        ],
        "failure_modes": [
          "invalid_request",
          "scope_unavailable",
          "capability_unsupported",
          "deadline_exceeded",
          "cancelled",
          "provider_unavailable",
          "contract_violation",
          "not_ready",
