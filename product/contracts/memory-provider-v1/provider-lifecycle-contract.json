  "feedback": {
    "type_name": "MemoryProviderFeedbackV1",
    "contract_id": "tracedecay.memory.provider.feedback.v1",
    "capability_id": "feedback.record.v1",
    "mutation": true,
    "required_request_fields": [
      "common_request",
      "target",
      "signal",
      "weight",
      "canonical_outcome_receipt",
      "evidence_refs",
      "occurred_at"
