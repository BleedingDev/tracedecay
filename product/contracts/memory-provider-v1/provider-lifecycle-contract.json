      "recall_trace_ref_scope_bound": true,
      "context_pack_item_ref_request_bound": true,
      "unknown_target_policy": "target_unknown"
    },
    "signals": [
      "helpful",
      "harmful",
      "ignored",
      "corrected",
      "superseded"
