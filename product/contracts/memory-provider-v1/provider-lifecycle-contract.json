      "last_source_sequence",
      "acknowledged_sequence",
      "state_generation_before",
      "state_generation_after",
      "applied_observations",
      "duplicate_observations",
      "partial",
      "provider_receipt_digest",
      "warnings"
    ]
  },
  "provider_local_projection": {
    "explicit_fact_capability_id": "facts.explicit.v1",
    "explain_trace_capability_id": "explain.trace.v1",
    "explicit_projection_is_native_fact_authority": false,
    "provider_explanation_is_proof": false,
    "promotion_to_native_requires_separate_authorized_operation": true,
    "missing_projection_or_explanation_outcome": "capability_unsupported_or_unavailable"
