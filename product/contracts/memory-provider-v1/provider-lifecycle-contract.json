        "removed_effects",
        "anonymized_effects",
        "retained_under_lock",
        "remaining_influence_count",
        "snapshots_examined",
        "snapshots_rewritten",
        "verification_query_digest",
        "verification_state",
        "state_generation_before",
        "state_generation_after"
      ],
      "verification_states": [
        "verified_absent",
        "verified_anonymized",
        "retained_under_explicit_lock",
        "verification_failed",
        "partial"
      ],
      "successful_remove_requires_remaining_influence_zero": true,
      "retention_lock_requires_explicit_receipt": true,
      "snapshot_omission_may_be_silent": false,
      "provider_recall_may_return_deleted_source": false
