    "contract_id": "tracedecay.memory.provider.health.v1",
    "capability_id": "provider.health.v1",
    "mutation": false,
    "required_request_fields": [
      "common_request",
      "requested_checks"
    ],
    "requested_checks": [
      "protocol",
      "state",
      "scope",
      "capacity",
      "persistence",
      "recovery",
      "privacy"
    ],
    "required_response_fields": [
      "provider_id",
      "provider_instance_id",
      "implementation_identity_digest",
      "state_identity_digest",
      "state_generation",
      "scope_digest",
      "readiness",
      "capability_states",
      "effective_limits_digest",
      "backlog",
      "recovery_state",
      "warnings"
    ],
