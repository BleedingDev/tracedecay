{
  "schema_version": 1,
  "contract_id": "tracedecay.memory.provider.lifecycle.v1",
  "bead_id": "tdmem-0205",
  "title": "Memory provider health, feedback, maintenance, inspection, correction, deletion, snapshot, and replay contract",
  "status": "accepted",
  "authority": "TraceDecay lifecycle admission and provider-local capability fabric",
  "scope": "coding_agents_only",
  "depends_on_contracts": [
    "tracedecay.memory.provider.registry.v1",
    "tracedecay.memory.provider.handshake.v1",
    "tracedecay.memory.provider.observation.v1",
    "tracedecay.memory.provider.recall.v1"
  ],
  "common_request": {
    "type_name": "MemoryProviderLifecycleRequestContextV1",
    "required_fields": [
      "provider_id",
      "registration_revision",
      "ready_receipt_digest",
      "exact_scope_identity",
      "operation_id",
      "idempotency_key",
      "expected_state_generation",
      "request_identity",
      "policy_revision",
      "deadline",
      "cancellation",
      "extensions"
    ],
    "operation_id_type": "uuid_v7_lowercase",
    "idempotency_key_encoding": "lowercase_hex_64",
    "exact_scope_match_required": true,
    "live_ready_receipt_required": true,
    "deadline_required": true,
    "cancellation_required": true,
    "unknown_optional_extension_policy": "preserve_opaque_inert_round_trip",
    "unknown_required_extension_policy": "reject_extension_unsupported",
    "provider_may_widen_scope": false,
    "provider_may_extend_deadline": false,
    "provider_may_mutate_tracedecay_authority": false
  },
  "capability_gating": {
    "type_name": "MemoryProviderLifecycleCapabilityGateV1",
    "capability_to_operation": [
      {
        "capability_id": "provider.health.v1",
        "operation_contract_id": "tracedecay.memory.provider.health.v1",
        "requirement": "mandatory"
      },
      {
        "capability_id": "feedback.record.v1",
        "operation_contract_id": "tracedecay.memory.provider.feedback.v1",
        "requirement": "optional"
      },
      {
        "capability_id": "maintenance.run.v1",
        "operation_contract_id": "tracedecay.memory.provider.maintenance.v1",
        "requirement": "optional"
      },
      {
        "capability_id": "inspection.read.v1",
        "operation_contract_id": "tracedecay.memory.provider.inspection.v1",
        "requirement": "optional"
      },
      {
        "capability_id": "correction.apply.v1",
        "operation_contract_id": "tracedecay.memory.provider.correction.v1",
        "requirement": "optional"
      },
      {
        "capability_id": "deletion.by_source.v1",
        "operation_contract_id": "tracedecay.memory.provider.deletion-by-source.v1",
        "requirement": "optional"
      },
      {
        "capability_id": "snapshot.export.v1",
        "operation_contract_id": "tracedecay.memory.provider.snapshot-export.v1",
        "requirement": "optional"
      },
      {
        "capability_id": "snapshot.restore.v1",
        "operation_contract_id": "tracedecay.memory.provider.snapshot-restore.v1",
        "requirement": "optional"
      },
      {
        "capability_id": "replay.apply.v1",
        "operation_contract_id": "tracedecay.memory.provider.replay.v1",
        "requirement": "optional"
      },
      {
        "capability_id": "facts.explicit.v1",
        "operation_contract_id": "tracedecay.memory.provider.explicit-fact-projection.v1",
        "requirement": "optional"
      },
      {
        "capability_id": "explain.trace.v1",
        "operation_contract_id": "tracedecay.memory.provider.explain-trace.v1",
        "requirement": "optional"
      }
