{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tracedecay.dev/schemas/memory-provider-v1/provider-registry-contract.schema.json",
  "title": "TraceDecay memory provider registry contract V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "contract_id",
    "bead_id",
    "title",
    "status",
    "authority",
    "scope",
    "provider_identity",
    "capability_identity",
    "capability_registry",
    "capability_catalog",
    "unknown_capability_contract",
    "registration_contract",
    "selection_contract",
    "bootstrap_slots",
    "invariants",
    "verification_beads"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "contract_id": {
      "const": "tracedecay.memory.provider.registry.v1"
    },
    "bead_id": {
      "const": "tdmem-0201"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "const": "accepted"
    },
    "authority": {
      "const": "TraceDecay provider registry composition root"
    },
    "scope": {
      "const": "coding_agents_only"
    },
    "provider_identity": {
      "$ref": "#/$defs/providerIdentity"
    },
    "capability_identity": {
      "$ref": "#/$defs/capabilityIdentity"
    },
    "capability_registry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mandatory",
        "optional"
      ],
      "properties": {
        "mandatory": {
          "type": "array",
          "minItems": 3,
          "uniqueItems": true,
          "items": {
            "allOf": [
              {
                "$ref": "#/$defs/capability"
              },
              {
                "properties": {
                  "requirement": {
                    "const": "mandatory"
                  }
                }
              }
            ]
          }
        },
        "optional": {
          "type": "array",
          "minItems": 12,
          "uniqueItems": true,
          "items": {
            "allOf": [
              {
                "$ref": "#/$defs/capability"
              },
              {
                "properties": {
                  "requirement": {
                    "const": "optional"
                  }
                }
              }
            ]
          }
        }
      }
    },
    "capability_catalog": {
      "type": "array",
      "minItems": 15,
      "maxItems": 15,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*\\.v[1-9][0-9]*$",
            "maxLength": 96
          }
        }
      }
    },
    "unknown_capability_contract": {
      "$ref": "#/$defs/unknownCapability"
    },
    "registration_contract": {
      "$ref": "#/$defs/registration"
    },
    "selection_contract": {
      "$ref": "#/$defs/selection"
    },
    "bootstrap_slots": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/bootstrapSlot"
      }
    },
    "invariants": {
      "type": "array",
      "minItems": 12,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 20
      }
    },
    "verification_beads": {
      "type": "array",
      "minItems": 10,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/beadId"
      }
    }
  },
  "$defs": {
    "beadId": {
      "type": "string",
      "pattern": "^tdmem-[0-9]{4}$"
    },
    "providerId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$",
      "maxLength": 64
    },
    "capabilityId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*\\.v[1-9][0-9]*$",
      "maxLength": 96
    },
    "ioField": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "contract_id",
        "required",
        "description"
      ],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$",
          "maxLength": 64
        },
        "contract_id": {
          "type": "string",
          "pattern": "^tracedecay\\\\.memory\\\\.[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*\\\\.(?:request|outcome)\\\\.v[1-9][0-9]*$",
          "maxLength": 160
        },
        "required": {
          "type": "boolean"
        },
        "description": {
          "type": "string",
          "minLength": 20
        }
      }
    },
    "compatibility": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "capability_major",
        "major_version_rule",
        "minor_extension_rule",
        "unknown_extension_rule",
        "activation_rule",
        "downgrade_rule"
      ],
      "properties": {
        "capability_major": {
          "const": 1
        },
        "major_version_rule": {
          "const": "exact_match"
        },
        "minor_extension_rule": {
          "const": "preserve_unknown_optional_fields"
        },
        "unknown_extension_rule": {
          "const": "preserve_opaque_or_reject_explicitly"
        },
        "activation_rule": {
          "const": "known_catalog_entry_and_explicit_registration_revision_and_explicit_selection"
        },
        "downgrade_rule": {
          "const": "no_implicit_downgrade"
        }
      }
    },
    "capability": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "requirement",
        "purpose",
        "operation_class",
        "inputs",
        "outputs",
        "failure_modes",
        "compatibility_rules",
        "detailed_contract_bead",
        "advisory_only",
        "may_mutate_tracedecay_authority"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/capabilityId"
        },
        "requirement": {
          "enum": [
            "mandatory",
            "optional"
          ]
        },
        "purpose": {
          "type": "string",
          "minLength": 30
        },
        "operation_class": {
          "enum": [
            "advisory_read",
            "provider_local_read",
            "provider_local_mutation"
          ]
        },
        "inputs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/ioField"
          }
        },
        "outputs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/ioField"
          }
        },
        "failure_modes": {
          "type": "array",
          "minItems": 7,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$",
            "maxLength": 80
          }
        },
        "compatibility_rules": {
          "$ref": "#/$defs/compatibility"
        },
        "detailed_contract_bead": {
          "$ref": "#/$defs/beadId"
        },
        "advisory_only": {
          "const": true
        },
        "may_mutate_tracedecay_authority": {
          "const": false
        }
      }
    },
    "providerIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type_name",
        "encoding",
        "canonical_pattern",
        "minimum_bytes",
        "maximum_bytes",
        "case_sensitive",
        "stable_across_restarts",
        "stable_across_adapter_upgrades",
        "display_name_is_not_identity",
        "forbidden_sources"
      ],
      "properties": {
        "type_name": {
          "const": "MemoryProviderIdV1"
        },
        "encoding": {
          "const": "utf-8"
        },
        "canonical_pattern": {
          "const": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$"
        },
        "minimum_bytes": {
          "const": 1
        },
        "maximum_bytes": {
          "const": 64
        },
        "case_sensitive": {
          "const": true
        },
        "stable_across_restarts": {
          "const": true
        },
        "stable_across_adapter_upgrades": {
          "const": true
        },
        "display_name_is_not_identity": {
          "const": true
        },
        "forbidden_sources": {
          "type": "array",
          "minItems": 7,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "capabilityIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type_name",
        "canonical_pattern",
        "maximum_bytes",
        "version_is_part_of_identity",
        "provider_name_is_not_capability_identity",
        "duplicate_capability_policy",
        "unknown_declaration_policy",
        "unknown_selection_policy"
      ],
      "properties": {
        "type_name": {
          "const": "MemoryProviderCapabilityIdV1"
        },
        "canonical_pattern": {
          "const": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*\\.v[1-9][0-9]*$"
        },
        "maximum_bytes": {
          "const": 96
        },
        "version_is_part_of_identity": {
          "const": true
        },
        "provider_name_is_not_capability_identity": {
          "const": true
        },
        "duplicate_capability_policy": {
          "const": "reject_non_canonical_declaration"
        },
        "unknown_declaration_policy": {
          "const": "preserve_opaque_inert"
        },
        "unknown_selection_policy": {
          "const": "typed_capability_unsupported"
        }
      }
    },
    "unknownCapability": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type_name",
        "accepted_identity_requirement",
        "wire_fields",
        "decode_policy",
        "encode_policy",
        "registration_policy",
        "activation_policy",
        "selection_policy",
        "may_count_as_mandatory",
        "may_satisfy_required_capability",
        "may_infer_behavior_from_name",
        "may_activate_from_presence"
      ],
      "properties": {
        "type_name": {
          "const": "OpaqueMemoryProviderCapabilityV1"
        },
        "accepted_identity_requirement": {
          "const": "syntactically_valid_versioned_capability_id"
        },
        "wire_fields": {
          "const": [
            "id",
            "canonical_payload"
          ]
        },
        "decode_policy": {
          "const": "preserve_canonical_payload_opaque"
        },
        "encode_policy": {
          "const": "round_trip_canonical_payload_without_semantic_rewrite"
        },
        "registration_policy": {
          "const": "retain_as_opaque_not_supported"
        },
        "activation_policy": {
          "const": "inert_until_catalog_acceptance_and_new_registration_revision_and_explicit_selection"
        },
        "selection_policy": {
          "const": "return_typed_capability_unsupported"
        },
        "may_count_as_mandatory": {
          "const": false
        },
        "may_satisfy_required_capability": {
          "const": false
        },
        "may_infer_behavior_from_name": {
          "const": false
        },
        "may_activate_from_presence": {
          "const": false
        }
      }
    },
    "registration": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type_name",
        "registry_writer",
        "provider_self_registration",
        "required_fields",
        "registration_states",
        "immutable_after_registration",
        "revision_rule",
        "mandatory_capability_rule",
        "unknown_capability_rule",
        "duplicate_provider_id_policy",
        "unknown_provider_policy",
        "adapter_construction_boundary",
        "public_surface_provider_branching",
        "recall_scope_bindings"
      ],
      "properties": {
        "type_name": {
          "const": "MemoryProviderRegistrationV1"
        },
        "registry_writer": {
          "const": "TraceDecay provider registry composition root"
        },
        "provider_self_registration": {
          "const": false
        },
        "required_fields": {
          "type": "array",
          "minItems": 8,
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "registration_states": {
          "const": [
            "registered",
            "disabled",
            "reserved",
            "retiring"
          ]
        },
        "immutable_after_registration": {
          "const": [
            "provider_id",
            "implementation_identity"
          ]
        },
        "revision_rule": {
          "type": "string",
          "minLength": 20
        },
        "mandatory_capability_rule": {
          "type": "string",
          "minLength": 20
        },
        "unknown_capability_rule": {
          "type": "string",
          "minLength": 20
        },
        "duplicate_provider_id_policy": {
          "const": "reject_ambiguous_registration"
        },
        "unknown_provider_policy": {
          "const": "reject_unknown_provider"
        },
        "adapter_construction_boundary": {
          "type": "string",
          "minLength": 20
        },
        "public_surface_provider_branching": {
          "const": false
        },
        "recall_scope_bindings": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "declared_by",
            "provider_may_self_declare",
            "values",
            "value_source",
            "provider_declarations",
            "admission_input",
            "unauthorized_binding_policy"
          ],
          "properties": {
            "declared_by": {
              "type": "string",
              "minLength": 1
            },
            "provider_may_self_declare": {
              "const": false
            },
            "values": {
              "const": [
                "exact_coding_scope",
                "project_facts",
                "profile_facts"
              ]
            },
            "value_source": {
              "type": "string",
              "minLength": 1
            },
            "provider_declarations": {
              "type": "object",
              "additionalProperties": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {
                  "enum": [
                    "exact_coding_scope",
                    "project_facts",
                    "profile_facts"
                  ]
                }
              }
            },
            "admission_input": {
              "const": "recorded_registration_passed_with_the_admitted_call"
            },
            "unauthorized_binding_policy": {
              "const": "reject_scope_binding_unauthorized"
            }
          }
        }
      }
    },
    "selection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type_name",
        "required_request_fields",
        "required_capability_semantics",
        "maximum_required_capabilities",
        "duplicate_required_capability_policy",
        "unknown_required_capability_policy",
        "active_provider_cardinality_per_exact_scope",
        "resolution_states",
        "resolved_requires",
        "silent_fallback",
        "fallback_provider",
        "successful_empty_resolution"
      ],
      "properties": {
        "type_name": {
          "const": "MemoryProviderSelectionRequestV1"
        },
        "required_request_fields": {
          "type": "array",
          "minItems": 7,
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "required_capability_semantics": {
          "const": "all"
        },
        "maximum_required_capabilities": {
          "const": 32
        },
        "duplicate_required_capability_policy": {
          "const": "reject_non_canonical_request"
        },
        "unknown_required_capability_policy": {
          "const": "return_typed_capability_unsupported"
        },
        "active_provider_cardinality_per_exact_scope": {
          "const": "zero_or_one"
        },
        "resolution_states": {
          "type": "array",
          "minItems": 14,
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "resolved_requires": {
          "type": "array",
          "minItems": 8,
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "silent_fallback": {
          "const": false
        },
        "fallback_provider": {
          "type": "null"
        },
        "successful_empty_resolution": {
          "const": false
        }
      }
    },
    "bootstrapSlot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "provider_id",
        "display_name",
        "slot_state",
        "specification_state",
        "capability_declaration_state",
        "implementation_gate_beads",
        "counts_as_implemented"
      ],
      "properties": {
        "provider_id": {
          "$ref": "#/$defs/providerId"
        },
        "display_name": {
          "type": "string",
          "minLength": 1
        },
        "slot_state": {
          "enum": [
            "declared",
            "reserved"
          ]
        },
        "specification_state": {
          "type": "string",
          "minLength": 1
        },
        "capability_declaration_state": {
          "enum": [
            "deferred_until_compatible_handshake",
            "unavailable_without_versioned_specification"
          ]
        },
        "implementation_gate_beads": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/beadId"
          }
        },
        "counts_as_implemented": {
          "const": false
        }
      }
    }
  }
}
