{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tracedecay.dev/schemas/product/upstream/external-lesson-intake.schema.json",
  "title": "TraceDecay source-linked external lesson intake",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "bead_id",
    "contract_id",
    "lessons",
    "policy",
    "schema_version",
    "title"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "contract_id": {
      "const": "tracedecay.external-lesson-intake.v1"
    },
    "bead_id": {
      "const": "tdmem-1207"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "accepted_requires_neutral_regression_tests",
        "copied_external_code_policy",
        "source_specific_assumptions_boundary",
        "statuses",
        "target_kinds"
      ],
      "properties": {
        "statuses": {
          "const": [
            "accepted",
            "rejected"
          ]
        },
        "target_kinds": {
          "const": [
            "capability",
            "policy"
          ]
        },
        "accepted_requires_neutral_regression_tests": {
          "const": true
        },
        "source_specific_assumptions_boundary": {
          "const": "adapter_only"
        },
        "copied_external_code_policy": {
          "const": "recorded_license_and_provenance_required"
        }
      }
    },
    "lessons": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/lesson"
      }
    }
  },
  "$defs": {
    "lesson": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code_use",
        "decision",
        "extracted_generic_invariant",
        "implementation_bead",
        "lesson_id",
        "neutral_regression_tests",
        "source",
        "source_assumptions",
        "status",
        "target"
      ],
      "properties": {
        "lesson_id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$"
        },
        "status": {
          "enum": [
            "accepted",
            "rejected"
          ]
        },
        "source": {
          "$ref": "#/$defs/source"
        },
        "extracted_generic_invariant": {
          "type": "string",
          "minLength": 1
        },
        "target": {
          "$ref": "#/$defs/target"
        },
        "source_assumptions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/assumption"
          }
        },
        "neutral_regression_tests": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/regression_test"
          }
        },
        "implementation_bead": {
          "type": "string",
          "pattern": "^tdmem-[0-9]{4}$"
        },
        "code_use": {
          "$ref": "#/$defs/code_use"
        },
        "decision": {
          "$ref": "#/$defs/decision"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "accepted"
              }
            }
          },
          "then": {
            "properties": {
              "neutral_regression_tests": {
                "minItems": 1
              },
              "decision": {
                "properties": {
                  "rejection_rationale": {
                    "type": "null"
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "rejected"
              }
            }
          },
          "then": {
            "properties": {
              "code_use": {
                "properties": {
                  "mode": {
                    "const": "none_rejected"
                  },
                  "external_code_copied": {
                    "const": false
                  },
                  "copy_records": {
                    "maxItems": 0
                  }
                }
              },
              "decision": {
                "properties": {
                  "rejection_rationale": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              }
            }
          }
        }
      ]
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "commit",
        "evidence",
        "identifiers",
        "license",
        "repository"
      ],
      "properties": {
        "repository": {
          "type": "string",
          "pattern": "^https://[^?#]+[^/?#]$"
        },
        "commit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "identifiers": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9._-]{1,63}$"
          }
        },
        "license": {
          "$ref": "#/$defs/license"
        },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/evidence"
          }
        }
      }
    },
    "license": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "evidence_path",
        "identity",
        "provenance_statement"
      ],
      "properties": {
        "identity": {
          "type": "string",
          "minLength": 1
        },
        "provenance_statement": {
          "type": "string",
          "minLength": 1
        },
        "evidence_path": {
          "type": "string",
          "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[^\\\\]+$"
        }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "claim",
        "local_evidence_path",
        "source_path",
        "source_url"
      ],
      "properties": {
        "source_path": {
          "type": "string",
          "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[^\\\\]+$"
        },
        "source_url": {
          "type": "string",
          "format": "uri"
        },
        "local_evidence_path": {
          "type": "string",
          "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[^\\\\]+$"
        },
        "claim": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contract_path",
        "id",
        "kind",
        "mapping"
      ],
      "properties": {
        "kind": {
          "enum": [
            "capability",
            "policy"
          ]
        },
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)+$"
        },
        "contract_path": {
          "type": "string",
          "pattern": "^product/(?!.*(?:^|/)\\.\\.(?:/|$))[^\\\\]+$"
        },
        "mapping": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "assumption": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "adapter_boundary",
        "adapter_path",
        "assumption"
      ],
      "properties": {
        "assumption": {
          "type": "string",
          "minLength": 1
        },
        "adapter_boundary": {
          "type": "string",
          "minLength": 1
        },
        "adapter_path": {
          "type": "string",
          "pattern": "^crates/tracedecay-memory-provider-(?!api(?:/|$)|native(?:/|$)|registry(?:/|$))[^/]+/.+$"
        }
      }
    },
    "regression_test": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "proves"
      ],
      "properties": {
        "path": {
          "type": "string",
          "pattern": "^tests/(?!.*(?:^|/)\\.\\.(?:/|$))[^\\\\]+$"
        },
        "proves": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "code_use": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "copy_records",
        "external_code_copied",
        "mode",
        "note"
      ],
      "properties": {
        "mode": {
          "enum": [
            "clean_reimplementation",
            "copied_external_code",
            "none_rejected"
          ]
        },
        "external_code_copied": {
          "type": "boolean"
        },
        "copy_records": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/copy_record"
          }
        },
        "note": {
          "type": "string",
          "minLength": 1
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "external_code_copied": {
                "const": true
              }
            }
          },
          "then": {
            "properties": {
              "mode": {
                "const": "copied_external_code"
              },
              "copy_records": {
                "minItems": 1
              }
            }
          },
          "else": {
            "properties": {
              "copy_records": {
                "maxItems": 0
              }
            }
          }
        }
      ]
    },
    "copy_record": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "destination_path",
        "license_notice_path",
        "source_path"
      ],
      "properties": {
        "source_path": {
          "type": "string",
          "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[^\\\\]+$"
        },
        "destination_path": {
          "type": "string",
          "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[^\\\\]+$"
        },
        "license_notice_path": {
          "type": "string",
          "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[^\\\\]+$"
        }
      }
    },
    "decision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rationale",
        "rejection_rationale"
      ],
      "properties": {
        "rationale": {
          "type": "string",
          "minLength": 1
        },
        "rejection_rationale": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    }
  }
}
